{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/situaedmilly/ALTONUMBUSELF/schemas/matter.schema.json",
  "title": "OURSELF Matter",
  "type": "object",
  "required": ["matter_id","matter_type","version","jurisdiction","semantic","inputs","outputs","state","invariants","preconditions","failure_states","transitions","algorithm","formulas","authority","capability","admission","execution","observation","witness","receipt","lineage","recontact","dependencies"],
  "properties": {
    "matter_id": {"type":"string","minLength":1},
    "matter_type": {"type":"string","minLength":1},
    "version": {"type":"string","minLength":1},
    "jurisdiction": {"type":"object","required":["reality","instance","substrate"],"properties":{"reality":{"type":"string"},"instance":{"type":"string"},"substrate":{"type":"string"}},"additionalProperties":true},
    "semantic": {"type":"object","required":["definition","semantic_type","vocabulary_refs"],"properties":{"definition":{"type":"string"},"semantic_type":{"type":"string"},"vocabulary_refs":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "inputs": {"type":"array","items":{"type":"object"}},
    "outputs": {"type":"array","items":{"type":"object"}},
    "state": {"type":"object"},
    "invariants": {"type":"array","items":{"type":"string"}},
    "preconditions": {"type":"array","items":{"type":"string"}},
    "failure_states": {"type":"array","items":{"type":"object"}},
    "transitions": {"type":"array","items":{"type":"object"}},
    "algorithm": {"anyOf":[{"type":"null"},{"type":"string"}]},
    "formulas": {"type":"array","items":{"type":"string"}},
    "authority": {"type":"object"},
    "capability": {"type":"object"},
    "admission": {"type":"object"},
    "execution": {"type":"object"},
    "observation": {"type":"object"},
    "witness": {"type":"object"},
    "receipt": {"type":"object"},
    "lineage": {"type":"object"},
    "recontact": {"type":"object"},
    "dependencies": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}